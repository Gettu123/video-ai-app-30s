# Copie para docker/.env antes do deploy:
#   cp .env.example .env
#
# Chave de criptografia do PocketBase: exatamente 32 caracteres.
#   openssl rand -hex 16
PB_ENCRYPTION_KEY=

# Superusuario criado automaticamente no primeiro boot
PB_ADMIN_EMAIL=admin@tu-dominio.com
PB_ADMIN_PASSWORD=

# Hosts publicos (Caddy pede certificado e faz o proxy)
PB_DOMAIN=pb.tu-dominio.com
N8N_DOMAIN=n8n.tu-dominio.com
VIDEO_DOMAIN=video.tu-dominio.com

# Solo el perfil GPU (docker-compose.gpu.yml)
# Token de Hugging Face si Hunyuan o CogVideoX piden licencia
HF_TOKEN=
# offload cabe en menos VRAM; cuda deja el modelo entero en la GPU
VRAM_MODE=offload
# Tope de clipes encadenados por VideoX-Fun (6 x ~5s = 30s)
MAX_CHAIN_SEGMENTS=6

